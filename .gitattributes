# Normalize line endings: LF in the repository, CRLF only for Windows scripts
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.nbt binary
*.zip binary

# Disable autocrlf on generated files, they always generate with LF
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf
