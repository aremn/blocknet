### Blocknet ###
# Local secrets and machine-specific settings: never commit
.env
.env.*
*.local.properties
local.properties

# Logs and crash reports from local runs
*.log
crash-reports/

# Local language caches
.venv/
__pycache__/
*.pyc

brain/logs/
brain/state.json
brain/mcp.json
brain/mcp.*.json

# Third-party sources pulled locally for reading, not vendored
_src/
